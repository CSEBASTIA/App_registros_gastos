# dependencias
node_modules/

# variables de entorno: todas las variantes (.env.staging, .env.test, prod.env…).
# Solo los .env.example se versionan.
.env
.env.*
*.env
!.env.example

# builds
dist/
build/
apps/desktop/src-tauri/target/

# expo
.expo/
apps/mobile/.expo-check/
apps/mobile/android/
apps/mobile/ios/
*.jsbundle
# exports web de verificación visual (expo export), se regeneran
apps/mobile/dist-*/

# supabase local
supabase/.branches/
supabase/.temp/

# sistema
.DS_Store
Thumbs.db
*.log

# cache/artefactos de build que no hace falta versionar
*.tsbuildinfo
.turbo/
coverage/
playwright-report/
test-results/

# volcados de imágenes sin procesar de tarjetas/logos (nombres con espacios,
# tal como se recibieron): las versiones ya normalizadas que usa la app viven
# en apps/desktop/src/assets/tarjetas/ y assets/logos/, esas sí se versionan.
apps/desktop/src/assets/Logotipos/
apps/desktop/src/assets/Tarjetas dinner club/
apps/desktop/src/assets/tarjetas produbanco/
# configuración local de Claude Code (launch.json, permisos)
.claude/

# credenciales de firma de Android/iOS si se gestionan en local (EAS las guarda en su servidor por defecto)
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# credenciales de servicios (el Client ID de Google/Microsoft es público; el
# "client secret", las claves de servicio y las claves privadas no)
client_secret*.json
service-account*.json
google-services.json
GoogleService-Info.plist
*.pem
*.key

# datos personales (docs/legal/README.md): solicitudes de las personas, copias
# de datos que se les entregan, evidencia de incidentes y correspondencia legal
docs/legal/privado/
exportacion-datos-*.json

# volcados y respaldos de la base: contienen datos reales de personas
*.dump
*.backup
supabase/backups/
