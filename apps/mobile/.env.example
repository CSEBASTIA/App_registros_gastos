EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública de la política de privacidad (se publica con la versión
# web: https://<tu-app>.vercel.app/privacidad.html). Obligatoria para
# `build:play` y `update:produccion`; la app la enlaza desde Más y el registro.
EXPO_PUBLIC_URL_PRIVACIDAD=

# Client ID del App Registration en Azure AD para conectar Outlook desde
# "Correo" — ver instrucciones en app/correo.tsx. Sin esto, todo lo demás
# de la app funciona igual; solo el botón "Conectar Outlook" queda inactivo.
EXPO_PUBLIC_MS_CLIENT_ID=

# Client ID (tipo "Web application") de Google Cloud Console para conectar
# Gmail — misma idea, ver instrucciones en app/correo.tsx.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Solo desarrollo: con 1 la app entra sin iniciar sesión para revisar el
# diseño (todo se ve vacío y no se puede guardar, porque la base exige
# sesión). Déjalo vacío para usar la app de verdad.
EXPO_PUBLIC_SIN_LOGIN=
