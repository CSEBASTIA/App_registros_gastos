EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Client ID del App Registration en Azure AD para conectar Outlook desde
# "Correo" — ver instrucciones en app/correo.tsx. Sin esto, todo lo demás
# de la app funciona igual; solo el botón "Conectar Outlook" queda inactivo.
EXPO_PUBLIC_MS_CLIENT_ID=

# Client ID (tipo "Web application") de Google Cloud Console para conectar
# Gmail — misma idea, ver instrucciones en app/correo.tsx.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
