EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Documentos legales (ver docs/legal/README.md) --------------------------
# Las dos direcciones públicas se publican con la versión web y la app las
# enlaza desde el registro y desde Más. Los tres valores son OBLIGATORIOS para
# `build:play` y `update:produccion` (el verificador se niega a seguir si faltan
# o si las páginas public/terminos.html y public/privacidad.html todavía tienen
# datos [por completar]); en desarrollo se dejan vacíos y la app oculta los enlaces.
# Todo EXPO_PUBLIC_* queda dentro de la app y es legible: aquí van solo datos
# que ya son públicos, nunca la cédula ni claves.
#
# Política de privacidad: https://<tu-app>.vercel.app/privacidad.html
EXPO_PUBLIC_URL_PRIVACIDAD=
# Términos y condiciones: https://<tu-app>.vercel.app/terminos.html
EXPO_PUBLIC_URL_TERMINOS=
# Correo de contacto para temas de privacidad (derechos, eliminar la cuenta):
# el mismo que aparece en las dos páginas. Mejor uno propio de la app.
EXPO_PUBLIC_CORREO_PRIVACIDAD=
# Interruptor de la aceptación: con 1, el registro pide marcar la casilla de
# aceptación y quien inicia sesión sin haber aceptado la versión vigente pasa
# por la pantalla «Revisa y acepta». Déjalo vacío (apagado) hasta que la base
# tenga las migraciones de aceptación (supabase/para-supabase-web/16-10-2026 5AM/
# archivos 2 y 3): sin ellas, esa pantalla bloquearía a todos. `build:play` y
# `update:produccion` exigen que sea 1.
EXPO_PUBLIC_EXIGIR_ACEPTACION=

# ---- Correo (opcional, beta): pasos en docs/guia-conectar-correo.md -----------
# Sin estos valores todo lo demás de la app funciona igual; solo los botones
# «Conectar Outlook» / «Conectar Gmail» quedan inactivos. Son identificadores
# públicos (no secretos): nunca pongas aquí un «client secret».
#
# Outlook: «ID de aplicación (cliente)» del registro en Microsoft Entra ID,
# como cliente público con la redirección gastosapp://redirect.
EXPO_PUBLIC_MS_CLIENT_ID=
# Gmail: Client ID de un cliente OAuth de tipo ANDROID (paquete
# com.csebastia.gastosapp + huella SHA-1 de la firma), con «esquema de URI
# personalizado» habilitado. Un cliente de tipo «Web» NO sirve.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Solo desarrollo: con 1 la app entra sin iniciar sesión para revisar el
# diseño (todo se ve vacío y no se puede guardar, porque la base exige
# sesión). Déjalo vacío para usar la app de verdad.
EXPO_PUBLIC_SIN_LOGIN=
