{
  "expo": {
    "name": "fintrack",
    "slug": "gastos-app",
    "scheme": "gastosapp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fintrack-app-icon.png",
    "splash": {
      "image": "./assets/brand/fintrack-lockup.png",
      "resizeMode": "contain",
      "backgroundColor": "#17191c"
    },
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a2907344-dbc9-4f5a-9e59-aa50b8393e14"
    },
    "android": {
      "package": "com.csebastia.gastosapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/fintrack-mark.png",
        "backgroundColor": "#17191c"
      },
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "com.csebastia.gastosapp"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FinTrack usa tu ubicación solo al registrar un pago, si activas «Guardar la ubicación de mis pagos», para mostrarte cuánto gastas en cada lugar.",
          "locationAlwaysAndWhenInUsePermission": "FinTrack usa tu ubicación solo mientras la app está abierta, al registrar un pago. Nunca en segundo plano.",
          "locationAlwaysPermission": "FinTrack usa tu ubicación solo mientras la app está abierta, al registrar un pago. Nunca en segundo plano.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a2907344-dbc9-4f5a-9e59-aa50b8393e14"
      }
    },
    "owner": "lans112"
  }
}
