{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test \"test/*.test.mjs\"",
    "verificar:publicacion": "node scripts/verificar-entorno-publicacion.mjs",
    "build:apk": "node scripts/verificar-entorno-publicacion.mjs && eas build --platform android --profile preview",
    "build:play": "node scripts/verificar-entorno-publicacion.mjs && eas build --platform android --profile production",
    "update:prueba": "node scripts/verificar-entorno-publicacion.mjs && eas update --channel preview",
    "update:produccion": "node scripts/verificar-entorno-publicacion.mjs && eas update --channel production"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.1.0",
    "@react-native/gradle-plugin": "0.74.87",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native/assets-registry": "0.74.87",
    "@react-navigation/bottom-tabs": "6.5.20",
    "@supabase/supabase-js": "^2.45.0",
    "core": "workspace:*",
    "expo": "~51.0.0",
    "expo-auth-session": "~5.5.2",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-font": "~12.0.10",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-modules-core": "~1.12.26",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.28",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-helmet-async": "^2.0.4",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.0",
    "typescript": "^5.5.0"
  }
}
